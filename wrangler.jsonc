{
  "name": "waterman-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // 只有詢問表單需要跑 Worker，其他請求直接走靜態檔
    "run_worker_first": ["/api/*"],
    // next.config 設了 trailingSlash，網址一律帶結尾斜線
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  // custom domain 由 Cloudflare 自動建 DNS 與憑證，比照 shop.waterman-sports.cc
  "routes": [{ "pattern": "ai.waterman-sports.cc", "custom_domain": true }],
  // 需要 waterman-sports.cc 開啟 Email Routing，收件地址要先通過驗證
  "send_email": [{ "name": "INQUIRY_EMAIL", "destination_address": "rai0603@gmail.com" }],
  "ratelimits": [
    { "name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
